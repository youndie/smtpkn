{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended"],

  // Once a week, in UTC. Updates arrive as one Monday-morning batch rather than a trickle of a PR
  // a day — every pull request here runs the full build, the mail stand and the E2E tests
  // included, and that is not cheap.
  timezone: "Etc/UTC",
  schedule: ["before 6am on monday"],

  // Commits here are Conventional Commits, and a hook enforces it. `config:recommended` maps
  // dependency bumps to `fix:` and everything else to `chore:`.
  semanticCommits: "enabled",

  labels: ["dependencies"],

  // With the build harness merging itself these numbers stop being a throttle on human attention
  // and become one on runner time, so they can be higher.
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Renovate merges the pull request itself rather than arming GitHub's auto-merge: GitHub refuses
  // to arm it on a branch with no required checks, and adding branch protection to `main` would
  // change how this repository is worked in.
  platformAutomerge: false,

  // Vulnerabilities are the one thing that ignores the schedule.
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    labels: ["dependencies", "security"],
  },

  // kotlin-js-store holds lock files the Kotlin/JS and Kotlin/Wasm plugins generate for themselves.
  ignorePaths: ["**/build/**", "**/.gradle/**", "**/kotlin-js-store/**"],

  packageRules: [
    {
      description: "Kotlin: the compiler and its plugins move as one version, and that is never a routine bump",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlin[:.]/"],
      groupName: "kotlin",
    },
    {
      description: "kotlinx ships as one release train — one PR",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlinx[:.]/"],
      groupName: "kotlinx",
    },
    {
      description: "kotlinx-datetime publishes `-compat` builds for consumers pinned to an older line. They sort as newer and are not upgrades",
      matchPackageNames: ["org.jetbrains.kotlinx:kotlinx-datetime"],
      allowedVersions: "!/-compat$/",
    },
    {
      // The build conventions are one release published under two names: the catalog entry
      // `sborka` (the plugin coordinates) and the settings plugin id resolved in
      // settings.gradle.kts. Without this they arrive as two pull requests for one number, which
      // is what happens today in the repositories that migrated first.
      description: "sborka is one release, not one release per place it is named",
      matchPackageNames: [
        "/^ru\\.workinprogress\\.sborka/",
        // The catalog's `sborka` version is read from the GitHub releases of the repository that
        // publishes the plugins, so Renovate knows the same release under a second name. Without
        // this line it arrives as a second pull request for the same number — which is exactly
        // what the repositories that migrated first are living with today.
        "youndie/sborka",
      ],
      groupName: "sborka",
    },
    {
      description: "Ktor modules share one version",
      matchPackageNames: ["/^io\\.ktor[:.]/"],
      groupName: "ktor",
    },
    {
      description: "KotlinCrypto ships as one release train",
      matchPackageNames: ["/^org\\.kotlincrypto[:.]/"],
      groupName: "kotlincrypto",
    },
    {
      description: "The build harness arrives as one PR, not one per action",
      matchManagers: ["github-actions"],
      groupName: "ci actions",
    },
    {
      // Mailpit and Postfix are not dependencies of this client — they are the servers it is
      // tested against, which is to say the oracle. A different server version can change what
      // the protocol tests are asserting about, so taking one is a decision and the whole suite
      // gets re-read after it, not just re-run.
      description: "The mail stand is the oracle, not a dependency",
      matchManagers: ["docker-compose"],
      automerge: false,
      additionalBranchPrefix: "stand-",
      labels: ["dependencies", "test server"],
    },
    {
      description: "Majors of anything that ships get a human",
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },
    // Last, so it wins over the major rule above. A major of `actions/checkout` is not the same
    // kind of event as a major of Ktor: the build harness is not shipped to anyone, and the check
    // that would catch a bad bump is the build itself — which already ran on the pull request.
    {
      description: "The build harness merges itself, majors included: CI on pull_request is the review",
      matchManagers: ["github-actions", "gradle-wrapper"],
      automerge: true,
      automergeType: "pr",
    },
  ],
}
