{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name: the timezone, the Monday schedule, the
  // limits, the kotlin/kotlinx/sborka/ci-actions groups and majors going to a human were identical
  // in ten repositories and now live in sborka.
  //
  // The automerge preset is extended second on purpose — its rule has to land after the base
  // preset's "majors get a human" to override it for the harness — and its precondition holds
  // here: ci.yaml runs on `pull_request`, so a pull request is reviewed by a build before it
  // merges itself. That is what this repository already did.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  // Below the extends, so these win: package rules are concatenated, preset first, and the last
  // match takes effect.
  packageRules: [
    {
      // DELIBERATELY BROADER THAN THE PRESET, which refuses `-0.6.x-compat` by name. The reason is
      // not about one line: a `-compat` build is the new version compiled against an OLD API, it
      // sorts as newer, and it is never an upgrade — whichever line it is published for. Dropping
      // this in favour of the preset's narrower pattern would quietly re-open the next one.
      description: "kotlinx-datetime publishes `-compat` builds for consumers pinned to an older line. They sort as newer and are not upgrades",
      matchPackageNames: ["org.jetbrains.kotlinx:kotlinx-datetime"],
      allowedVersions: "!/-compat$/",
    },
    {
      description: "Ktor modules share one version",
      matchPackageNames: ["/^io\\.ktor[:.]/"],
      groupName: "ktor",
    },
    {
      description: "KotlinCrypto ships as one release train",
      matchPackageNames: ["/^org\\.kotlincrypto[:.]/"],
      groupName: "kotlincrypto",
    },
    {
      // Mailpit and Postfix are not dependencies of this client — they are the servers it is
      // tested against, which is to say the oracle. A different server version can change what
      // the protocol tests are asserting about, so taking one is a decision and the whole suite
      // gets re-read after it, not just re-run.
      description: "The mail stand is the oracle, not a dependency",
      matchManagers: ["docker-compose"],
      automerge: false,
      additionalBranchPrefix: "stand-",
      labels: ["dependencies", "test server"],
    },
  ],
}
